# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase → Project Settings → API → service_role key.
# Server-only. Bypasses row-level security. Never expose to the browser,
# never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel login (single user, shared secret — see src/lib/admin/session.ts).
# Pick your own values; ADMIN_SESSION_SECRET should be a long random string
# (e.g. `openssl rand -hex 32`). Changing it logs everyone out.
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Optional, for SEO — search-engine ownership verification (see src/app/layout.tsx).
# Leave unset until you've deployed and added the site in each console; the
# corresponding meta tag just won't render if these are empty.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=